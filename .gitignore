__pycache__/
*.pyc
.DS_Store

# Generated by the scripts. For each project, regenerate with:
#   python3 projects/<slug>/build.py            -> its permit set and its zoning sheet
#                                                  (C-102, 11 x 17, its own document)
#   python3 lib/export/dxf.py projects/<slug>/build.py
#                                               -> its floor plans DXF (re-runs the build
#                                                  for its canvas calls, writes only the DXF)
# EVERY project's outputs are committed: the issued sheet is the deliverable and it is
# useful to see which commit produced which drawing. They are rebuilt at every merge, so
# a tracked output can never fall behind the source that made it -- an untracked set
# once drifted weeks behind its source. A deliverable is named by its suffix (lib/buildkit.py
# and harness/scaffold.py name them so); everything else of these types is scratch and
# stays out.
*.pdf
*.dxf
!*-permit-set.pdf
!*-zoning-site-plan.pdf
!*-floor-plans.dxf

# Worktrees other sessions are using, scratch and each person's settings; never this repo's
# content. The hooks and the skills ARE: they are the guard rails and procedures every
# session and every worktree checkout gets. The settings that wire the hooks are a choice
# (python3 -m harness.hooks install) and stay out, unless a repository already tracks them.
.claude/*
!.claude/hooks/
!.claude/skills/
!.claude/agents/

# SDD scratch: one workspace per plan, recreated on demand
.superpowers/

# lib/verify/gate.py: the base commits it has built, keyed by commit and tools
.verify-cache/

# pip install -e and a wheel build
*.egg-info/
build/
dist/
